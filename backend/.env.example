# ============================================================================
# agri-pest-agent 后端配置样例
# 复制为 backend/.env 后按需修改。.env 已在 .gitignore 中，不会被提交。
# ============================================================================

APP_NAME=农业病虫害智能诊断与农事决策 Agent
ENV=dev
DEBUG=true
API_PREFIX=/api/v1
# 前端开发服务器地址，用于 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 数据库（对应 scripts/infra.py 建好的本地 PostgreSQL）
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://agri:agri_dev_pwd@127.0.0.1:5432/agri_pest
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis（缓存 + Celery broker）
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# 没有 Redis 时设为 false，任务改为进程内 BackgroundTasks 执行
USE_CELERY=true

# ---------------------------------------------------------------------------
# MinIO 对象存储（图片、知识库原文）
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=agriadmin
MINIO_SECRET_KEY=agri_dev_pwd
MINIO_BUCKET=agri-media
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000

# ---------------------------------------------------------------------------
# 大模型（OpenAI 兼容接口）
# 常见三家填法：
#   DeepSeek : LLM_BASE_URL=https://api.deepseek.com/v1          LLM_MODEL=deepseek-chat
#   通义千问 : LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#              LLM_MODEL=qwen-plus   LLM_VISION_MODEL=qwen-vl-plus
#   智谱 GLM : LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
#              LLM_VISION_MODEL=glm-4v-flash
#
# ★ 留空 LLM_API_KEY 时系统自动进入「无 Key 降级模式」：
#   诊断走知识库关键词匹配，问答走本地规则引擎，整条流程依然可跑通。
#
# ★ 改完本文件**必须重启后端**才生效：
#     python scripts/infra.py restart-app
#   否则页面看起来一切正常，只是新填的 Key 没起作用 —— 很容易误判成 Key 填错。
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# ★ 视觉模型。留空会**回落到 LLM_MODEL**（也就是 deepseek-chat）——
#   而 deepseek-chat 不支持图片。此时 /health 里 vision_enabled 仍然是 true
#   （它只看 API Key 非空），拍照诊断会静默走到一个看不懂图的模型上。
#   ★ 要用拍照诊断，必须在这里单独填一个多模态模型，例如 qwen-vl-plus
#     或 glm-4v-flash（对应上面的 base_url 也要一起换）。
LLM_VISION_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# 备用模型（主模型失败时自动切换，对应文档第七章「LLM 服务失败」兜底）
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---------------------------------------------------------------------------
# 向量化（Embedding）
# provider=local  : 用 sentence-transformers 本地模型（无需联网，推荐）
# provider=openai : 用 OpenAI 兼容的 /embeddings 接口
# 注意：切换 provider 会改变向量维度，需要重新建索引（scripts/reindex.py）
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 国内下载 HuggingFace 模型走镜像
HF_ENDPOINT=https://hf-mirror.com

# ---------------------------------------------------------------------------
# RAG 混合检索（对应文档难点 5）
# ---------------------------------------------------------------------------
RAG_TOP_K=8
RAG_CANDIDATE_K=40
RAG_VECTOR_WEIGHT=1.0
RAG_KEYWORD_WEIGHT=1.0
RAG_RRF_K=60
RAG_MIN_SCORE=0.0
RAG_CHUNK_SIZE=420
RAG_CHUNK_OVERLAP=60

# ---------------------------------------------------------------------------
# 置信度闸门（对应文档难点 1 / 第七章）
# ★ 这是文档里最关键也最容易做错的一处：
#   多模态大模型自报的「置信度」不可校准，不能直接当阈值用。
#   本项目把置信度定义为可计算量，由三项加权：
#     margin      候选第一名与第二名的证据分差
#     agreement   多张图片诊断结果的一致性
#     coverage    知识库证据覆盖度
#   只有三项加权后的分数低于阈值，才触发「要求补充拍照」。
# ---------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.55
CONFIDENCE_W_MARGIN=0.45
CONFIDENCE_W_AGREEMENT=0.30
CONFIDENCE_W_COVERAGE=0.25
# 低于此值直接判定为「无法识别」，不进候选列表
CONFIDENCE_REJECT_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# 农药规则引擎（对应文档难点 3）
# ---------------------------------------------------------------------------
# 规则校验不通过时，是否完全禁止输出任何农药产品名
RULE_HARD_BLOCK=true
# 安全间隔期不足多少天时给出警告
SAFETY_INTERVAL_WARN_DAYS=3
# 同一有效成分连续使用超过多少次给出抗性警告
RESISTANCE_REPEAT_LIMIT=2
# 输出层剂量拦截：命中即从回答中剔除相关句子
DOSE_GUARD_ENABLED=true

# ---------------------------------------------------------------------------
# 天气（对应文档难点 7）
#
# 真实天气源已实现（和风天气）：
# - WEATHER_PROVIDER=qweather + 填好 Key 后，天气接口与 Agent 对话里的
#   天气风险提示都会用真实数据；取数失败或没有地块坐标时自动降级回
#   mock，并带 is_mock=true + caveat 声明（降级可见）
# - WEATHER_API_BASE：控制台-设置里分配给你的**专属 API Host**
#   （形如 abc123.xy.qweatherapi.com，带不带 https:// 都可以）
# - 免费档没有历史天气：切到真实源后窗口只含真实拿到过的日子
# - WEATHER_CACHE_TTL_SECONDS：今天这条数据的最长保鲜期，过期自动重拉
# ---------------------------------------------------------------------------
WEATHER_PROVIDER=mock
WEATHER_API_KEY=
WEATHER_API_BASE=
WEATHER_TIMEOUT_SECONDS=8
WEATHER_CACHE_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# 认证与安全（对应文档难点 14）
# ★ 生产环境必须替换 JWT_SECRET
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 上传限制
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# 上传图片是否剥离 EXIF（照片 GPS 会泄露农田位置，默认必须剥离）
STRIP_EXIF=true
